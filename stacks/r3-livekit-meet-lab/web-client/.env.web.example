# Environment variables needed to connect to the LiveKit server.
# For host dev, use BOT_RUNNER_URL=http://localhost:7860/.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Browser-facing URL returned to clients by /api/connection-details.
# For remote/ngrok demos, use a public LiveKit URL (for example: wss://<project>.livekit.cloud).
LIVEKIT_URL=ws://localhost:7880
# Optional container-internal URL for server-side concierge/admin calls.
# LIVEKIT_URL_INTERNAL=ws://transport-server:7880

# Optional base URL used for human invite links generated by Concierge.
# Defaults to http://<host>:3001
# MEET_BASE_URL=http://localhost:3001

# FastAPI bot runner (server-side call from Next.js)
BOT_RUNNER_URL=http://agent-runner:7860/

# Concierge APIs and webhook verification reuse LIVEKIT_API_KEY/LIVEKIT_API_SECRET.
# Webhook path: /api/concierge/webhooks/livekit
