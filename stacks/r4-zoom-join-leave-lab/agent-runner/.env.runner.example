# Modes:
# - stub: no external Zoom call, only in-memory bot session tracking
# - webhook: forwards join/leave to your external Zoom meeting bot service
ZOOM_CLIENT_MODE=webhook

# Required when ZOOM_CLIENT_MODE=webhook
ZOOM_JOIN_ENDPOINT=http://zoom-connector:8787/join
ZOOM_LEAVE_ENDPOINT=http://zoom-connector:8787/leave

# Optional bearer token for webhook mode
ZOOM_API_TOKEN=

# HTTP timeout in seconds for webhook calls
ZOOM_REQUEST_TIMEOUT_SECS=10
