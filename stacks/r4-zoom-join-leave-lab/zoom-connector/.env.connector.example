# Modes:
# - mock: deterministic in-memory join/leave for local orchestration tests
# - process: spawn/stop a worker command for each bot join/leave
ZOOM_CONNECTOR_MODE=mock

# Optional artificial delay to simulate slower meeting joins.
ZOOM_JOIN_DELAY_MS=0

# Required when ZOOM_CONNECTOR_MODE=process.
# Placeholders available in command templates:
# {bot_id} {meeting_url} {meeting_id} {meeting_number} {meeting_passcode} {session_id}
#
# Example local worker:
# ZOOM_WORKER_JOIN_COMMAND=python /app/scripts/fake_zoom_worker.py --bot-id {bot_id} --meeting-url {meeting_url} --meeting-id {meeting_number} --passcode {meeting_passcode} --session-id {session_id}
ZOOM_WORKER_JOIN_COMMAND=

# Optional command executed during leave before process termination.
ZOOM_WORKER_LEAVE_COMMAND=

# Grace period before force-killing a worker during leave/shutdown.
ZOOM_WORKER_STOP_GRACE_SECS=8
